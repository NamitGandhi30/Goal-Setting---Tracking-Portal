# ── App Configuration ────────────────────────────────────
APP_NAME=Goal Tracking Portal API
DEBUG=true

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/goals_db

# ── Auth ─────────────────────────────────────────────────
SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── Dev Utilities ─────────────────────────────────────────
AUTO_SEED=false

# Phase 3 notifications
APP_FRONTEND_URL=http://localhost:3000
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=change-me

SMTP_FROM_EMAIL=you@example.com
SMTP_USE_TLS=true
TEAMS_WEBHOOK_URL=

# Microsoft Entra ID
ENTRA_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_JWKS_URL=
ENTRA_ADMIN_GROUP_ID=
ENTRA_MANAGER_GROUP_ID=
