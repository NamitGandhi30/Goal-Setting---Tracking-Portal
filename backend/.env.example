# ── App Configuration ────────────────────────────────────
APP_NAME=Goal Tracking Portal API
DEBUG=false

# ── Database ─────────────────────────────────────────────
# Supabase direct connection, recommended for migrations:
DATABASE_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres
#
# Supabase transaction pooler, useful for app runtime:
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── Auth ─────────────────────────────────────────────────
SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=["https://your-vercel-domain"]

# ── Dev Utilities ─────────────────────────────────────────
AUTO_SEED=false

# Phase 3 notifications
APP_FRONTEND_URL=https://your-vercel-domain

# Resend email delivery. If RESEND_API_KEY and RESEND_FROM_EMAIL are set,
# Resend is used instead of SMTP.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Goal Tracking Portal <notifications@your-domain.com>"
RESEND_REPLY_TO=

# SMTP fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=change-me

SMTP_FROM_EMAIL=you@example.com
SMTP_USE_TLS=true
TEAMS_WEBHOOK_URL=

# Microsoft Entra ID
ENTRA_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_JWKS_URL=
ENTRA_ADMIN_GROUP_ID=
ENTRA_MANAGER_GROUP_ID=
