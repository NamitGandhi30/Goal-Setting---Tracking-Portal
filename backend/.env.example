# ── App Configuration ────────────────────────────────────
APP_NAME=Goal Tracking Portal API
DEBUG=true

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/goals_db

# ── Auth ─────────────────────────────────────────────────
SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── Dev Utilities ─────────────────────────────────────────
AUTO_SEED=false
